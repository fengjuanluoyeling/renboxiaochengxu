/**index.wxss**/
page {
  min-height: 100vh;
  background: #f6f8fb;
}

.page {
  position: relative;
  min-height: 100vh;
  overflow: visible;
}

.backgroundPicture {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 42vh;
  opacity: 0.2;
  z-index: 0;
}

.backgroundMask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 46vh;
  background: linear-gradient(180deg, rgba(246, 248, 251, 0), #f6f8fb 86%);
  z-index: 1;
}

.content {
  position: relative;
  z-index: 2;
  padding: 32rpx 28rpx 52rpx;
  box-sizing: border-box;
}

.noticeBar {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid #c8d9ee;
  border-radius: 16rpx;
  background: #eef6ff;
  color: #15395b;
  box-shadow: 0 8rpx 20rpx rgba(20, 54, 86, 0.06);
}

.noticeTag {
  flex: 0 0 auto;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #0b5cab;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 1.4;
}

.noticeText {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.55;
}

.navigationCard {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 24rpx;
  padding: 26rpx 24rpx;
  border: 1rpx solid rgba(31, 78, 91, 0.16);
  border-radius: 16rpx;
  background: rgba(255, 253, 249, 0.97);
  box-shadow: 0 12rpx 30rpx rgba(16, 42, 67, 0.08);
}

.navigationCardHover {
  opacity: 0.88;
  transform: translateY(2rpx);
}

.navigationMain {
  flex: 1;
  min-width: 0;
}

.navigationEyebrow {
  display: block;
  color: #7a6960;
  font-size: 22rpx;
  line-height: 1.3;
}

.navigationTitle {
  display: block;
  margin-top: 6rpx;
  color: #18393f;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.25;
}

.navigationDesc {
  display: block;
  margin-top: 10rpx;
  color: #617171;
  font-size: 24rpx;
  line-height: 1.55;
}

.navigationAction {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  min-width: 92rpx;
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 6rpx;
  background: #1f4e5b;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
}

.calendarPanel {
  margin-top: 28rpx;
  padding: 28rpx 24rpx 30rpx;
  border: 1rpx solid #e3eaf2;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 14rpx 34rpx rgba(16, 42, 67, 0.08);
}

.calendarHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.monthInfo {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.title {
  color: #102a43;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.25;
}

.subtitle {
  margin-top: 6rpx;
  color: #627d98;
  font-size: 24rpx;
  line-height: 1.4;
}

.navButton {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 72rpx;
  width: 64rpx;
  height: 64rpx;
  padding: 0;
  border-radius: 50%;
  background: #f0f5fb;
  color: #0b5cab;
  font-size: 42rpx;
  line-height: 1;
  font-weight: 700;
}

.navButtonHover {
  background: #dceafa;
}

.statusSummary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 28rpx;
}

.summaryItem {
  min-height: 96rpx;
  padding: 14rpx 10rpx;
  border-radius: 14rpx;
  box-sizing: border-box;
  text-align: center;
}

.summaryNumber {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.1;
}

.summaryLabel {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.2;
}

.summaryOpen {
  background: #e7f7ef;
  color: #0f6f49;
}

.summaryClosed {
  background: #fff0ef;
  color: #aa3428;
}

.summaryUnknown {
  background: #f1f4f8;
  color: #52616f;
}

.legend {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  margin-top: 24rpx;
  color: #486581;
  font-size: 23rpx;
}

.legendItem {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legendDot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.dotOpen {
  background: #2a9d6f;
}

.dotClosed {
  background: #e76f51;
}

.dotUnknown {
  background: #9aa6b2;
}

.weekendtab {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-top: 26rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid #edf2f7;
  border-bottom: 1rpx solid #edf2f7;
  color: #627d98;
  font-size: 22rpx;
}

.weekendtab > text {
  text-align: center;
  line-height: 1.4;
}

.canlender {
  display: flex;
  flex-wrap: wrap;
  padding-top: 12rpx;
}

.canlenderblock {
  width: 14.285%;
  padding: 6rpx;
  box-sizing: border-box;
}
