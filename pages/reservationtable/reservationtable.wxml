<!--pages/reservationtable/reservationtable.wxml-->
<view class="page">
  <view class="hero">
    <text class="heroTitle">个人参观预约</text>
    <text class="heroText">请在确认当日开馆后，阅读入馆须知并扫码完成入馆登记。</text>
  </view>

  <view class="section">
    <view class="sectionHeader">
      <text class="sectionTitle">入馆须知</text>
      <text class="sectionTag">参观前必读</text>
    </view>

    <view class="noticeList">
      <view class="noticeItem">
        <text class="noticeIndex">1</text>
        <text class="noticeText">本页适用于个人参观登记；10人及以上团队请使用“团队参观预约”。</text>
      </view>
      <view class="noticeItem">
        <text class="noticeIndex">2</text>
        <text class="noticeText">馆内标本具有医学人体标本的特殊性，请提前调整心态，文明、安静参观。</text>
      </view>
      <view class="noticeItem">
        <text class="noticeIndex">3</text>
        <text class="noticeText">参观期间请勿拍照、摄影、饮食、吸烟、喧哗，请勿触摸或移动标本。</text>
      </view>
      <view class="noticeItem">
        <text class="noticeIndex">4</text>
        <text class="noticeText">未成年人建议由监护人陪同参观，并请全程遵守现场管理要求。</text>
      </view>
      <view class="noticeItem">
        <text class="noticeIndex">5</text>
        <text class="noticeText">如遇闭馆、寒暑假或临时调整，请以馆方最新公告和现场安排为准。</text>
      </view>
    </view>
  </view>

  <view class="timeSection">
    <view class="sectionHeader">
      <text class="sectionTitle">场馆开放时间</text>
      <text class="sectionTag">请按时到馆</text>
    </view>
    <view class="timeGrid">
      <view class="timeItem">
        <text class="timeLabel">上午</text>
        <text class="timeValue">8:30-11:30</text>
      </view>
      <view class="timeItem">
        <text class="timeLabel">下午</text>
        <text class="timeValue">13:30-16:30</text>
      </view>
    </view>
  </view>

  <view class="qrSection">
    <view class="qrHeader">
      <text class="sectionTitle">入馆登记二维码</text>
      <text class="qrHint">长按识别或保存</text>
    </view>
    <view class="qrCard">
      <image
        src="/images/浙江大学人体博物馆入馆登记表.png"
        mode="widthFix"
        class="qrImage"
        show-menu-by-longpress="{{true}}"
      />
    </view>
    <text class="footerTip">请在到馆前或现场按照工作人员指引完成登记。</text>
  </view>
</view>
