page {
  min-height: 100vh;
  background: #f6f8fb;
  color: #102a43;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
  box-sizing: border-box;
}

.hero {
  padding: 34rpx 30rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #0b5cab, #1f7a8c);
  color: #ffffff;
  box-shadow: 0 14rpx 30rpx rgba(11, 92, 171, 0.18);
}

.heroTitle {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.25;
}

.heroText {
  display: block;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 26rpx;
  line-height: 1.55;
}

.section,
.timeSection,
.qrSection {
  margin-top: 24rpx;
  padding: 28rpx 26rpx;
  border: 1rpx solid #e3eaf2;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(16, 42, 67, 0.06);
}

.sectionHeader,
.qrHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.sectionTitle {
  color: #102a43;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
}

.sectionTag,
.qrHint {
  flex: 0 0 auto;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #eef6ff;
  color: #0b5cab;
  font-size: 22rpx;
  line-height: 1.3;
}

.noticeList {
  margin-top: 22rpx;
}

.noticeItem {
  display: flex;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eef2f7;
}

.noticeItem:last-child {
  border-bottom: none;
}

.noticeIndex {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 38rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #e7f7ef;
  color: #0f6f49;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.noticeText {
  flex: 1;
  color: #334e68;
  font-size: 26rpx;
  line-height: 1.58;
}

.timeGrid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 24rpx;
}

.timeItem {
  padding: 22rpx 18rpx;
  border-radius: 16rpx;
  background: #f0f7ff;
  text-align: center;
}

.timeLabel {
  display: block;
  color: #486581;
  font-size: 24rpx;
  line-height: 1.3;
}

.timeValue {
  display: block;
  margin-top: 8rpx;
  color: #0b5cab;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.25;
}

.qrCard {
  display: flex;
  justify-content: center;
  margin-top: 24rpx;
  padding: 26rpx 20rpx;
  border: 1rpx solid #d9e2ec;
  border-radius: 18rpx;
  background: #f9fbfd;
}

.qrImage {
  width: 470rpx;
  max-width: 100%;
  border-radius: 10rpx;
}

.footerTip {
  display: block;
  margin-top: 18rpx;
  color: #627d98;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}
