/* pages/caption/caption.wxss */

.page {
    min-height: 100vh;
    background: #f6f2eb;
    color: #1d2526;
}

.page-scroll {
    height: 100vh;
    box-sizing: border-box;
    padding: 36rpx 28rpx 132rpx;
}

.header {
    margin-bottom: 28rpx;
}

.museum-name {
    display: block;
    color: #697777;
    font-size: 25rpx;
    line-height: 1.4;
}

.page-title {
    display: block;
    margin-top: 8rpx;
    color: #182323;
    font-size: 46rpx;
    font-weight: 700;
    line-height: 1.2;
}

.floor-list {
    display: flex;
    flex-direction: column;
}

.floor-card {
    overflow: hidden;
    margin-bottom: 26rpx;
    border: 1rpx solid rgba(38, 68, 72, 0.13);
    border-radius: 8rpx;
    background: #fffdf9;
    box-shadow: 0 14rpx 36rpx rgba(25, 39, 38, 0.08);
}

.floor-card-hover {
    opacity: 0.86;
    transform: translateY(2rpx);
}

.map-preview {
    height: 260rpx;
    padding: 18rpx;
    box-sizing: border-box;
    background: #eef3ee;
}

.map-image {
    width: 100%;
    height: 100%;
}

.floor-content {
    padding: 28rpx 28rpx 26rpx;
}

.floor-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16rpx;
}

.floor-name {
    color: #172424;
    font-size: 40rpx;
    font-weight: 700;
    line-height: 1.2;
}

.floor-tag {
    padding: 7rpx 14rpx;
    border-radius: 6rpx;
    background: #e5eee8;
    color: #3e6159;
    font-size: 22rpx;
    line-height: 1.2;
}

.floor-desc {
    display: block;
    color: #576564;
    font-size: 26rpx;
    line-height: 1.65;
}

.floor-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 24rpx;
    padding-top: 22rpx;
    border-top: 1rpx solid rgba(38, 68, 72, 0.11);
}

.floor-count {
    color: #7a6960;
    font-size: 24rpx;
    line-height: 1.2;
}

.floor-action {
    min-width: 96rpx;
    padding: 12rpx 20rpx;
    border-radius: 6rpx;
    background: #1f4e5b;
    color: #ffffff;
    font-size: 24rpx;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
}
