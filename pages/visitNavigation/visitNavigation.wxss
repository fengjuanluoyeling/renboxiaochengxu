/* pages/visitNavigation/visitNavigation.wxss */
page {
  min-height: 100vh;
  background: #f6f2eb;
}

.page {
  min-height: 100vh;
  color: #1d2526;
}

.page-scroll {
  height: 100vh;
  box-sizing: border-box;
  padding: 36rpx 28rpx 132rpx;
}

.header {
  margin-bottom: 26rpx;
}

.museum-name {
  display: block;
  color: #6f7776;
  font-size: 25rpx;
  line-height: 1.4;
}

.page-title {
  display: block;
  margin-top: 8rpx;
  color: #182323;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.2;
}

.page-desc {
  display: block;
  margin-top: 14rpx;
  color: #596766;
  font-size: 27rpx;
  line-height: 1.65;
}

.notice-card,
.time-card,
.route-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(38, 68, 72, 0.13);
  border-radius: 8rpx;
  background: #fffdf9;
  box-shadow: 0 12rpx 30rpx rgba(25, 39, 38, 0.07);
}

.notice-card {
  border-left: 8rpx solid #1f4e5b;
}

.notice-title,
.section-title {
  display: block;
  color: #172424;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.3;
}

.notice-text {
  display: block;
  margin-top: 14rpx;
  color: #576564;
  font-size: 26rpx;
  line-height: 1.7;
}

.time-header,
.route-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 22rpx;
}

.section-note {
  flex: 0 0 auto;
  color: #7a6960;
  font-size: 23rpx;
  line-height: 1.3;
}

.time-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.time-item {
  padding: 20rpx 18rpx;
  border-radius: 6rpx;
  background: #eef3ee;
}

.time-label {
  display: block;
  color: #64706f;
  font-size: 23rpx;
  line-height: 1.3;
}

.time-value {
  display: block;
  margin-top: 8rpx;
  color: #18393f;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
}

.route-step {
  position: relative;
  display: flex;
  gap: 22rpx;
  padding-bottom: 34rpx;
}

.route-step::after {
  content: "";
  position: absolute;
  left: 31rpx;
  top: 62rpx;
  bottom: 10rpx;
  width: 2rpx;
  background: #d6e0dc;
}

.route-step-last {
  padding-bottom: 0;
}

.route-step-last::after {
  display: none;
}

.step-number {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #1f4e5b;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  z-index: 1;
}

.step-content {
  flex: 1;
  min-width: 0;
  padding-top: 4rpx;
}

.step-title {
  display: block;
  color: #172424;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.step-text {
  display: block;
  margin-top: 10rpx;
  color: #596766;
  font-size: 26rpx;
  line-height: 1.7;
}

.step-photo {
  overflow: hidden;
  margin-top: 18rpx;
  border: 1rpx solid #e1e7e3;
  border-radius: 8rpx;
  background: #f7f8f5;
}

.step-image {
  display: block;
  width: 100%;
  height: 230rpx;
}

.step-caption {
  display: block;
  padding: 12rpx 16rpx;
  color: #6b7775;
  font-size: 23rpx;
  line-height: 1.35;
}

.copy-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 192rpx;
  height: 58rpx;
  margin: 18rpx 0 0;
  padding: 0 20rpx;
  border: 1rpx solid #1f4e5b !important;
  border-radius: 6rpx;
  color: #1f4e5b;
  background: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 58rpx;
}

.copy-button::after {
  border: 0;
}
