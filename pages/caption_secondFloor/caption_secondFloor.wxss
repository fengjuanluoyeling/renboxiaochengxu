/* pages/caption_secondFloor/caption_secondFloor.wxss */

.page-container {
  width: 100%;
  height: 100%;
  min-height: 100vh;
  background-color: #edf2f7;
  overflow: hidden;
  position: fixed;
}

.page-scroll {
  height: 100vh;
  padding: 24rpx 22rpx 44rpx;
  box-sizing: border-box;
}

.map-card {
  overflow: hidden;
  border: 1rpx solid rgba(45, 67, 86, 0.12);
  border-radius: 16rpx;
  background-color: #f8fafc;
  box-shadow: 0 12rpx 36rpx rgba(34, 55, 74, 0.13);
}

.floor-map {
  display: block;
  width: 100%;
}

.guide-panel {
  margin-top: 24rpx;
  padding-bottom: 30rpx;
}

.guide-heading {
  display: flex;
  flex-direction: column;
  padding: 0 4rpx 16rpx;
}

.guide-title {
  color: #132d3e;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.35;
}

.guide-subtitle {
  margin-top: 6rpx;
  color: #607282;
  font-size: 24rpx;
  line-height: 1.45;
}

.Grid_layout {
  display: flex;
  flex-direction: column;
}

.fold-item {
  position: relative;
  margin: 0 0 16rpx;
  padding: 0;
  border: 1rpx solid rgba(37, 61, 78, 0.12);
  border-radius: 16rpx;
  background-color: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(31, 50, 64, 0.06);
}

.fold-item:active {
  background-color: #f3f7fa;
}

.container {
  width: 100%;
  min-height: 108rpx;
  padding: 22rpx 26rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.class1 { order: 1; }
.class2 { order: 2; }
.class3 { order: 3; }
.class4 { order: 4; }
.class5 { order: 5; }
.class6 { order: 6; }
.class7 { order: 7; }
.class9 { order: 8; }
.class10 { order: 9; }
.class11 { order: 10; }
.class12 { order: 11; }

.guide-item-title {
  color: #173348;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
}

.guide-item-desc {
  margin-top: 6rpx;
  color: #6a7885;
  font-size: 24rpx;
  line-height: 1.45;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.modal-content {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 84%;
  padding-left: 4%;
  padding-right: 4%;
  max-width: 600rpx;
  max-height: 70vh;
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  z-index: 1001;
  display: flex;
  flex-direction: column;
  box-shadow: 0 18rpx 54rpx rgba(17, 37, 52, 0.24);
}

.modal-header {
  padding: 30rpx 0 24rpx;
  border-bottom: 1rpx solid rgba(37, 61, 78, 0.12);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #173348;
}

.modal-close {
  font-size: 36rpx;
  color: #999;
  padding: 10rpx;
}

.modal-body {
  height: 58vh;
  padding: 24rpx 0 30rpx;
  box-sizing: border-box;
  background-color: #ffffff;
}

.textContent {
  font-size: 14px;
  line-height: 1.85;
  color: #243746;
}

.textNote {
  font-size: 10px;
}
