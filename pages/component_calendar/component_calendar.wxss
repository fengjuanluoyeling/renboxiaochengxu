/* pages/component_calendar/component_calendar.wxss */
.container {
  width: 100%;
  text-align: center;
}

.dateCard {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 90rpx;
  border: 1rpx solid transparent;
  border-radius: 14rpx;
  box-sizing: border-box;
}

.dateNumber {
  color: inherit;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.15;
}

.dateStatus {
  margin-top: 7rpx;
  color: inherit;
  font-size: 18rpx;
  line-height: 1.1;
}

.open {
  background: #e7f7ef;
  border-color: #b7e3cb;
  color: #0f6f49;
}

.closed {
  background: #fff0ef;
  border-color: #f4c5bd;
  color: #aa3428;
}

.unknown {
  background: #f1f4f8;
  border-color: #d8e0e8;
  color: #52616f;
}

.today {
  border-color: #0b5cab;
  box-shadow: 0 0 0 3rpx rgba(11, 92, 171, 0.16);
}

.blank {
  min-height: 90rpx;
  background: transparent;
}
