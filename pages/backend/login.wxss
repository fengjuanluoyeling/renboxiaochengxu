/* pages/login/login.wxss */
.container {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f5f5f5;
  }
  
  .login-box {
    width: 600rpx;
    background: white;
    padding: 60rpx 40rpx;
    border-radius: 20rpx;
    box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
  }
  
  .title {
    font-size: 48rpx;
    font-weight: bold;
    text-align: center;
    margin-bottom: 60rpx;
  }
  
  .input-group {
    margin-bottom: 40rpx;
  }
  
  .label {
    display: block;
    font-size: 28rpx;
    color: #666;
    margin-bottom: 16rpx;
  }
  
  .input {
    width: 100%;
    height: 80rpx;
    border: 2rpx solid #ddd;
    border-radius: 8rpx;
    padding: 0 20rpx;
    font-size: 28rpx;
    box-sizing: border-box;
  }
  
  .input:focus {
    border-color: #007aff;
  }
  
  .login-btn {
    width: 100%;
    height: 80rpx;
    background: #007aff;
    color: white;
    border-radius: 8rpx;
    font-size: 32rpx;
    margin-top: 40rpx;
    line-height: 80rpx;
  }
  
  .login-btn:active {
    opacity: 0.8;
  }
  
  .error-msg {
    margin-top: 30rpx;
    color: #ff3b30;
    font-size: 24rpx;
    text-align: center;
  }