<!--pages/backend/management.wxml-->
<view class="container">
    <view>公告更新处</view>
  <input 
    placeholder="请输入公告内容" 
    bindinput="onInput" 
  />
  <button bindtap="goToTabBarWithData">提交</button>
</view>

<view class="container">
  <text>请输入招募人员时间段（可添加多个）：</text>
  
  <!-- 已添加的标签列表 -->
  <view class="tags-list" wx:if="{{timeList.length > 0}}">
    <view class="tag" wx:for="{{timeList}}" wx:key="index">
      <text>{{item}}</text>
      <text class="tag-close" bindtap="removeTag" data-index="{{index}}">×</text>
    </view>
  </view>
  
  <!-- 输入框和添加按钮 -->
  <view class="input-group">
    <input 
      class="input" 
      placeholder="输入时间段，如：周一上午"
      model:value="{{inputValue}}"
      bindconfirm="addTag"
    />
    <button class="btn-add" bindtap="addTag">添加</button>
  </view>
  <view class="hint">提示：输入后点击添加或按回车键</view>
</view>

<!-- 数据收集表格  -->
<view>
  <view class="header">
    <text>数据表格（共{{list.length}}条）</text>
    <button size="mini" bindtap="clearAll">清空所有</button>
  </view>
  
  <scroll-view scroll-x="true" class="table-wrapper">
    <view class="table">
      <view class="tr header-row">
        <view class="th">讲解员/值班员</view>
        <view class="th">姓名</view>
        <view class="th">电话</view>
        <view class="th">服务时间</view>
      </view>
      <view class="tr" wx:for="{{list}}" wx:key="id">
        <view class="td">{{item.career}}</view>
        <view class="td">{{item.name}}</view>
        <view class="td">{{item.phone}}</view>
        <view class="td">{{item.worktime}}</view>
      </view>
      <view class="tr header-row">
        <view class="th">是否参加两个时间段</view>
        <view class="th">取钥匙</view>
        <view class="th">备注</view>
        <view class="th">提交时间</view>
      </view>
      <view class="tr" wx:for="{{list}}" wx:key="id">
        <view class="td">{{item.workTwice}}</view>
        <view class="td">{{item.key || '-'}}</view>
        <view class="td">{{item.note || '-'}}</view>
        <view class="td">{{item.time}}</view>
      </view>
      
      <!-- 空状态 -->
      <view class="empty" wx:if="{{list.length === 0}}">
        暂无数据，请先去填写表单
      </view>
    </view>
  </scroll-view>
</view>

<!-- 开放状态更新（每年7或8月进行） -->
    <view>
        <button class="btn-open" bindtap="onSelectOpen">
            开放状态更新（每年7或8月进行）
        </button>
    </view>